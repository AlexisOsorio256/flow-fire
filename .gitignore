# Caché de Godot 4 (se regenera al abrir el proyecto)
.godot/

# Sistema
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/
*.swp

# Capturas de pantalla: no aportan nada al repo. Solo se versiona la evidencia
# de revision de captures/review/, una hoja por accion revisada (idle, ads,
# fire, burst, reload, reload_empty, inspect, pen, crate, steel).
captures/*
!captures/review/
!captures/review/**
# ...pero sus .import no: los regenera Godot al importar el proyecto.
captures/review/*.import
