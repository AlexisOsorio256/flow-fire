# Caché de Godot 4 (se regenera al abrir el proyecto)
.godot/

# Sistema
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/
*.swp

# Capturas de diagnostico: se regeneran con --visualab/--timeline y no aportan
# nada al repo. Solo se versiona la evidencia de auditoria de captures/review/.
captures/*
!captures/review/
!captures/review/**
# ...pero sus .import no: los regenera Godot al importar el proyecto.
captures/review/*.import
